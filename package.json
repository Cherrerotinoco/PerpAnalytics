{
    "name": "perps-analytics",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build --config app/vite.config.ts && vite build --config app/vite.ssr.config.ts && tsx scripts/prerender.ts",
        "build:client": "vite build --config app/vite.config.ts",
        "typecheck": "tsc --noEmit",
        "dev:app": "vite --config app/vite.config.ts",
        "build:app": "vite build --config app/vite.config.ts",
        "preview:app": "vite preview --config app/vite.config.ts",
        "lint": "eslint app/src",
        "format": "prettier --write app/src",
        "test": "vitest run app/src",
        "test:watch": "vitest app/src"
    },
    "engines": {
        "node": ">=18"
    },
    "devDependencies": {
        "@types/node": "22.19.19",
        "@types/react": "19.2.15",
        "@types/react-dom": "19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "@vitejs/plugin-react": "6.0.2",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^10.1.8",
        "postcss": "8.5.15",
        "prettier": "^3.8.3",
        "tsx": "4.19.0",
        "typescript": "5.9.3",
        "vite": "8.0.14",
        "vitest": "^2.1.9"
    },
    "dependencies": {
        "gridstack": "^12.6.0",
        "lightweight-charts": "^5.2.0",
        "react": "19.2.6",
        "react-dom": "19.2.6",
        "react-icons": "^5.6.0",
        "react-router-dom": "7.15.1",
        "recharts": "2.15.4",
        "vanilla-cookieconsent": "^3.1.0"
    }
}